# ==========================================================================
# MEDINI CRM BACKEND — EXAMPLE ENVIRONMENT (NO REAL SECRETS)
# Copy to .env for local development. NEVER commit real credentials.
# ==========================================================================

# --- Runtime ---
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1

# --- Database (PostgreSQL 16) — dev placeholder only ---
# DATABASE_URL = admin/owner connection (migrations + seed). Dev uses port 5433
# (Docker) to avoid the native Windows PG on 5432.
DATABASE_URL=postgres://medini:***@localhost:5433/medini_dev
# DATABASE_RUNTIME_URL = application runtime connection. MUST be the non-owner,
# RLS-subject role (medini_app), NEVER the table owner (medini). Production
# refuses the dev default credential — provide a real secret via env/secrets.
DATABASE_RUNTIME_URL=postgres://medini_app:***@localhost:5433/medini_dev
# DEV/TEST only: seeds Argon2id hash of this for the 4 demo users. Never set in prod.
SEED_DEMO_PASSWORD=medini123

# --- Redis (queue + cache) — dev placeholder only ---
REDIS_URL=redis://localhost:6379

# --- Auth (JWT) — dev placeholders ONLY; override via secrets in staging/prod ---
JWT_SECRET=dev_only_insecure_jwt_secret_change_me
JWT_REFRESH_SECRET=dev_only_insecure_refresh_secret_change_me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# --- Object storage (S3-compatible) — dev placeholders ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=medini-dev
S3_ACCESS_KEY=dev_only_access_key
S3_SECRET_KEY=dev_only_secret_key

# --- WAHA (WhatsApp transport) — NOT built in Sprint 0; placeholders only ---
WAHA_BASE_URL=http://localhost:3001
WAHA_API_KEY=

# --- Bukku (accounting) — NEVER hardcode; leave empty locally; real via secrets ---
BUKKU_BASE_URL=https://api.bukku.my
BUKKU_API_KEY=
BUKKU_COMPANY_SUBDOMAIN=

# --- AI provider — placeholders only ---
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=

# --- Logging ---
LOG_LEVEL=debug
